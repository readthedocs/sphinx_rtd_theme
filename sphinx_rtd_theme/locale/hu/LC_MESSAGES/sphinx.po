#. This is an ARIA section label for page links, including previous/next page
#. link and links to GitHub/GitLab/etc.
#: sphinx_rtd_theme/breadcrumbs.html:22
msgid "Page navigation"
msgstr "Oldalnavigáció"

#: sphinx_rtd_theme/breadcrumbs.html:37 sphinx_rtd_theme/breadcrumbs.html:39
msgid "Edit on GitHub"
msgstr "Szerkesztés GitHubon"

#: sphinx_rtd_theme/breadcrumbs.html:44 sphinx_rtd_theme/breadcrumbs.html:46
msgid "Edit on Bitbucket"
msgstr "Szerkesztés Bitbucketen"

#: sphinx_rtd_theme/breadcrumbs.html:51 sphinx_rtd_theme/breadcrumbs.html:53
msgid "Edit on GitLab"
msgstr "Szerkesztés GitLabon"

#: sphinx_rtd_theme/breadcrumbs.html:56 sphinx_rtd_theme/breadcrumbs.html:58
msgid "View page source"
msgstr "Oldal forrásának megtekintése"

#. This is an ARIA section label for sequential page links, such as previous
#. and next page links.
#: sphinx_rtd_theme/breadcrumbs.html:67
msgid "Sequential page navigation"
msgstr "Egymást követő oldalnavigáció"

#: sphinx_rtd_theme/breadcrumbs.html:69 sphinx_rtd_theme/footer.html:6
msgid "Previous"
msgstr "Előző"

#: sphinx_rtd_theme/breadcrumbs.html:72 sphinx_rtd_theme/footer.html:9
msgid "Next"
msgstr "Következő"

#. This is an ARIA section label for the footer section of the page.
#: sphinx_rtd_theme/footer.html:4
msgid "Footer"
msgstr "Lábléc"

#: sphinx_rtd_theme/footer.html:21
#, python-format
msgid "&#169; <a href=\"%(path)s\">Copyright</a> %(copyright)s."
msgstr "&#169; <a href=\"%(path)s\">Szerzői jog</a> %(copyright)s."

#: sphinx_rtd_theme/footer.html:23
#, python-format
msgid "&#169; Copyright %(copyright)s."
msgstr "&#169; Szerzői jog: %(copyright)s."

#. Build is a noun, not a verb
#: sphinx_rtd_theme/footer.html:30
msgid "Build"
msgstr "Összeállítás"

#. the phrase "revision" comes from Git, referring to a commit
#: sphinx_rtd_theme/footer.html:36
msgid "Revision"
msgstr "Revízió"

#: sphinx_rtd_theme/footer.html:41
#, python-format
msgid "Last updated on %(last_updated)s."
msgstr "Utoljára frissítve: %(last_updated)s."

#. the variable "sphinx_web" is a link to the Sphinx project documentation with
#. the text "Sphinx"
#: sphinx_rtd_theme/footer.html:53
#, python-format
msgid "Built with %(sphinx_web)s using a"
msgstr "A %(sphinx_web)s segítségével összeállítva egy olyan"

#. "theme" refers to a theme for Sphinx, which alters the appearance of the
#. generated documentation
#: sphinx_rtd_theme/footer.html:55
msgid "theme"
msgstr "téma"

#. this is always used as "provided by Read the Docs", and should not imply
#. Read the Docs is an author of the generated documentation.
#: sphinx_rtd_theme/footer.html:57
#, python-format
msgid "provided by %(readthedocs_web)s"
msgstr "használatával, amelyet a %(readthedocs_web)s biztosít"

#: sphinx_rtd_theme/layout.html:97
#, python-format
msgid "Search within %(docstitle)s"
msgstr "Keresés ebben: %(docstitle)s"

#: sphinx_rtd_theme/layout.html:105
msgid "About these documents"
msgstr "A dokumentumok névjegye"

#: sphinx_rtd_theme/layout.html:108
msgid "Index"
msgstr "Tárgymutató"

#: sphinx_rtd_theme/layout.html:111 sphinx_rtd_theme/search.html:11
msgid "Search"
msgstr "Keresés"

#: sphinx_rtd_theme/layout.html:114
msgid "Copyright"
msgstr "Szerzői jog"

#: sphinx_rtd_theme/layout.html:143
msgid "Logo"
msgstr "Logó"

#. This is an ARIA section label for the main navigation menu
#: sphinx_rtd_theme/layout.html:166
msgid "Navigation menu"
msgstr "Navigációs menü"

#. This is an ARIA section label for the navigation menu that is visible when
#. viewing the page on mobile devices
#: sphinx_rtd_theme/layout.html:188
msgid "Mobile navigation menu"
msgstr "Mobil navigációs menü"

#: sphinx_rtd_theme/search.html:31
msgid "Please activate JavaScript to enable the search functionality."
msgstr "Kapcsolja be a JavaScriptet a keresési funkció engedélyezéséhez."

#. Search is a noun, not a verb
#: sphinx_rtd_theme/search.html:39
msgid "Search Results"
msgstr "Keresési eredmények"

#: sphinx_rtd_theme/search.html:41
msgid ""
"Your search did not match any documents. Please make sure that all words are "
"spelled correctly and that you've selected enough categories."
msgstr ""
"A keresése nem talált egyetlen dokumentumot sem. Győződjön meg arról, hogy "
"minden szó helyesen van-e írva, és hogy elegendő kategóriát választott-e ki."

#: sphinx_rtd_theme/searchbox.html:4
msgid "Search docs"
msgstr "Dokumentumok keresése"

#: sphinx_rtd_theme/versions.html:3 sphinx_rtd_theme/versions.html:11
msgid "Versions"
msgstr "Verziók"

#: sphinx_rtd_theme/versions.html:17
msgid "Downloads"
msgstr "Letöltések"

#. The phrase "Read the Docs" is not translated
#: sphinx_rtd_theme/versions.html:24
msgid "On Read the Docs"
msgstr "A Read the Docs oldalon"

#: sphinx_rtd_theme/versions.html:26
msgid "Project Home"
msgstr "Projekt kezdőlapja"

#: sphinx_rtd_theme/versions.html:29
msgid "Builds"
msgstr "Összeállítások"
